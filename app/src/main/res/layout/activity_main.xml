<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background" android:padding="13dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/homeButton" android:layout_width="52dp"
            android:layout_height="48dp" android:gravity="center" android:background="@drawable/tab_normal"
            android:text="‹" android:textSize="30sp" android:textColor="@color/primary_dark"
            android:contentDescription="Choisir une langue"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingLeft="10dp">
            <TextView android:id="@+id/mainHeading" android:text="Le Saint Coran"
                android:textSize="25sp" android:textStyle="bold" android:textColor="@color/primary_dark"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/mainSubtitle" android:text="114 sourates"
                android:textSize="13sp" android:textColor="@color/muted"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView android:id="@+id/settingsButton" android:layout_width="52dp"
            android:layout_height="48dp" android:gravity="center" android:background="@drawable/tab_normal"
            android:text="⚙" android:textSize="25sp" android:textColor="@color/primary_dark"
            android:contentDescription="Réglages et mises à jour"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="15dp" android:layout_marginTop="10dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/hero_bg">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="القرآن الكريم" android:textSize="23sp"
            android:textColor="#FFE3AD"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="✦  CORAN  ✦" android:textSize="23sp"
            android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/tabFrench" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="56dp"
            android:background="@drawable/tab_selected" android:gravity="center"
            android:text="🇫🇷 Français" android:textColor="#FFFFFF" android:textSize="14sp"
            android:textStyle="bold"/>
        <TextView android:id="@+id/tabEnglish" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="56dp" android:layout_marginLeft="5dp"
            android:background="@drawable/tab_normal" android:gravity="center"
            android:text="🇬🇧 English" android:textColor="@color/primary_dark" android:textSize="14sp"
            android:textStyle="bold"/>
        <TextView android:id="@+id/tabArabic" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="56dp" android:layout_marginLeft="5dp"
            android:background="@drawable/tab_normal" android:gravity="center"
            android:text="🇸🇦 العربية" android:textColor="@color/primary_dark" android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/readingModeTab" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp" android:gravity="center"
            android:text="📖 Lire" android:textSize="17sp" android:textStyle="bold"
            android:background="@drawable/tab_selected" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/listenAllTab" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp" android:layout_marginLeft="7dp"
            android:gravity="center" android:text="🎧 Écouter" android:textSize="17sp"
            android:textStyle="bold" android:background="@drawable/tab_normal"
            android:textColor="@color/text"
            android:contentDescription="Écouter et télécharger des sourates complètes"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/resumeButton" android:layout_width="0dp"
            android:layout_weight="2" android:layout_height="52dp" android:gravity="center"
            android:background="@drawable/tab_selected"
            android:textColor="#FFFFFF" android:textSize="13sp" android:text="▶ Reprendre"/>
        <TextView android:id="@+id/favoritesButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp" android:layout_marginLeft="6dp"
            android:gravity="center" android:background="@drawable/tab_normal"
            android:textColor="@color/primary_dark" android:textSize="13sp" android:text="★ Favoris"/>
    </LinearLayout>
    <EditText android:id="@+id/searchInput" android:hint="@string/surah_search"
        android:singleLine="true" android:inputType="text" android:padding="12dp"
        android:layout_marginTop="12dp" android:background="@drawable/tab_normal"
        android:layout_width="match_parent" android:layout_height="52dp"/>
    <TextView android:id="@+id/statusText" android:text="114 sourates"
        android:textColor="@color/muted" android:padding="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/surahList" android:dividerHeight="8dp"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp"/>
</LinearLayout>
