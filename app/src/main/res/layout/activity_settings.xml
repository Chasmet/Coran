<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:text="Réglages" android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="20dp"/>
        <TextView android:text="Langues affichées" android:textSize="18sp"
            android:textColor="@color/text" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/showArabic" android:text="Arabe — texte original"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/showFrench" android:text="Français — Muhammad Hamidullah"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/showEnglish" android:text="Anglais — Saheeh International"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Taille de lecture" android:textSize="18sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text" android:paddingTop="24dp"/>
        <SeekBar android:id="@+id/fontSize" android:max="14"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/fontSizeLabel" android:text="Taille standard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/muted" />
        <TextView android:text="Mise à jour automatique · SkillMajAuto"
            android:textSize="18sp" android:paddingTop="24dp" android:textColor="@color/text"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <CheckBox android:id="@+id/autoUpdate" android:text="Rechercher une nouvelle version au démarrage"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/checkUpdate" android:text="Vérifier les mises à jour"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/updateStatus" android:padding="10dp"
            android:textColor="@color/muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView android:text="Sources : Al Quran Cloud (alquran.cloud), texte arabe Uthmani, traduction française Muhammad Hamidullah, traduction anglaise Saheeh International. Récitation : Mishary Rashid Alafasy. Traductions et enregistrements restent la propriété de leurs ayants droit. Connexion nécessaire au premier chargement d’une sourate et pour les nouveaux fichiers audio."
            android:paddingTop="24dp" android:textSize="13sp"
            android:textColor="@color/muted" android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
