<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/card_bg"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ayahNumber" android:text="1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="@color/gold"/>
        <Button android:id="@+id/bookmarkButton" android:text="☆"
            android:contentDescription="Favori" android:layout_width="56dp"
            android:layout_height="wrap_content"/>
        <Button android:id="@+id/ayahPlayButton" android:text="▶"
            android:contentDescription="Écouter ce verset" android:layout_width="56dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView android:id="@+id/arabicText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textDirection="rtl" android:gravity="right"
        android:lineSpacingExtra="8dp" android:paddingTop="14dp" android:paddingBottom="14dp"
        android:textColor="@color/text" android:textSize="28sp"/>
    <TextView android:id="@+id/frenchText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="10dp"
        android:textColor="@color/text" android:lineSpacingExtra="4dp" android:textSize="16sp"/>
    <TextView android:id="@+id/englishText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingBottom="8dp"
        android:textColor="@color/muted" android:lineSpacingExtra="4dp" android:textSize="16sp"/>
</LinearLayout>
