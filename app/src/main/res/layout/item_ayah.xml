<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="13dp"
    android:background="@drawable/card_bg"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ayahNumber" android:text="✦ 1"
            android:layout_width="0dp" android:layout_weight="1" android:textStyle="bold"
            android:layout_height="wrap_content" android:textColor="@color/gold" android:textSize="16sp"/>
        <TextView android:id="@+id/bookmarkButton" android:text="☆"
            android:contentDescription="Ajouter aux favoris" android:background="@drawable/tab_normal"
            android:gravity="center" android:textColor="@color/gold" android:textSize="25sp"
            android:layout_width="50dp" android:layout_height="42dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/ayahBody" android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/arabicText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textDirection="rtl" android:gravity="right"
            android:lineSpacingExtra="8dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:textColor="@color/primary_dark" android:textSize="28sp"/>
        <TextView android:id="@+id/frenchText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="8dp"
            android:textColor="@color/text" android:lineSpacingExtra="4dp" android:textSize="17sp"/>
        <TextView android:id="@+id/englishText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingBottom="8dp"
            android:textColor="@color/muted" android:lineSpacingExtra="4dp" android:textSize="17sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="8dp" android:background="@drawable/tab_normal"
        android:padding="4dp">
        <TextView android:id="@+id/ayahPlayButton" android:layout_width="43dp"
            android:layout_height="45dp" android:gravity="center" android:background="@drawable/tab_selected"
            android:text="▶" android:textColor="#FFFFFF" android:textSize="17sp"
            android:contentDescription="Écouter ou suspendre le verset"/>
        <TextView android:id="@+id/ayahElapsed" android:layout_width="40dp"
            android:layout_height="wrap_content" android:text="0:00" android:gravity="center"
            android:textColor="@color/text" android:textSize="12sp"/>
        <SeekBar android:id="@+id/ayahProgress" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:max="100"/>
        <TextView android:id="@+id/ayahDuration" android:layout_width="39dp"
            android:layout_height="wrap_content" android:text="—" android:gravity="center"
            android:textColor="@color/text" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
