<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="right">
            <TextView android:id="@+id/welcomeSettings" android:layout_width="54dp"
                android:layout_height="52dp" android:text="⚙" android:gravity="center"
                android:textSize="26sp" android:textColor="@color/primary_dark"
                android:contentDescription="Réglages et mises à jour" android:background="@drawable/tab_normal"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="28dp" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/hero_bg">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="☪" android:textSize="52sp"
                android:textColor="#E5C482"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="القرآن الكريم" android:gravity="center" android:textSize="29sp"
                android:textColor="#FFF2D2"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Coran" android:gravity="center" android:textSize="43sp"
                android:textStyle="bold" android:textColor="#FFF2D2"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="✦  114 sourates  ✦" android:gravity="center" android:textSize="15sp"
                android:textColor="#E5C482" android:paddingTop="8dp"/>
        </LinearLayout>
        <TextView android:id="@+id/welcomeHint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:text="Choisissez votre langue pour lire et écouter les 114 sourates"
            android:layout_marginTop="28dp" android:layout_marginBottom="16dp"
            android:textColor="@color/text" android:textSize="18sp"/>
        <TextView android:id="@+id/welcomeFrench" android:layout_width="match_parent"
            android:layout_height="66dp" android:layout_marginTop="10dp"
            android:background="@drawable/tab_selected" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:text="🇫🇷   Français" android:textStyle="bold" android:textSize="23sp"
            android:textColor="#FFFFFF" android:contentDescription="Ouvrir la version française"/>
        <TextView android:id="@+id/welcomeEnglish" android:layout_width="match_parent"
            android:layout_height="66dp" android:layout_marginTop="14dp"
            android:background="@drawable/tab_normal" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:text="🇬🇧   English" android:textStyle="bold" android:textSize="23sp"
            android:textColor="@color/primary_dark" android:contentDescription="Open the English version"/>
        <TextView android:id="@+id/welcomeArabic" android:layout_width="match_parent"
            android:layout_height="66dp" android:layout_marginTop="14dp"
            android:background="@drawable/tab_normal" android:gravity="center"
            android:clickable="true" android:focusable="true"
            android:text="🇸🇦   العربية" android:textStyle="bold" android:textSize="25sp"
            android:textColor="@color/primary_dark" android:contentDescription="افتح النسخة العربية"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:gravity="center"
            android:text="✦  Lecture et audio verset par verset  ✦"
            android:textSize="14sp" android:textColor="@color/muted"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:gravity="center"
            android:text="Français · English · العربية"
            android:textSize="14sp" android:textColor="@color/gold"/>
    </LinearLayout>
</ScrollView>
